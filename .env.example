# Create a bot with @BotFather and paste its token here.
TELEGRAM_BOT_TOKEN=

# Add the bot to your channel as administrator with permission to post.
# Public channel: @channel_name. Private channel: numeric ID, e.g. -1001234567890.
TELEGRAM_CHANNEL_ID=

# Set this after the bot prints your Telegram chat ID in response to /start.
TELEGRAM_ADMIN_CHAT_ID=

# Optional model override. Must be available for your ChatGPT plan connection.
CHATGPT_MODEL=gpt-6.1-sol

TIMEZONE=Asia/Yekaterinburg
SCHEDULE_TIME=09:00
