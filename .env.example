TELEGRAM_BOT_TOKEN=

# MAX adapter (запускается отдельно: python max_main.py). Пользовательские
# профили и IDs собираются ботом в MAX, здесь нужен только токен самого бота.
MAX_BOT_TOKEN=

CHATGPT_MODEL=gpt-6.1-sol
OPENAI_API_KEY=
# ChatGPT-подписка для MAX подключается из диалога командой /chatgpt.
OPENAI_IMAGE_MODEL=gpt-image-1.5

TIMEZONE=Asia/Yekaterinburg
DAILY_AI_LIMIT=30
DAILY_USER_LIMIT=5
DAILY_IMAGE_LIMIT=10
DAILY_USER_IMAGE_LIMIT=3
